    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ===== PRELOADER =====
            const preloader = document.getElementById('bz-preloader');
            if (preloader) {
                const hidePreloader = () => {
                    preloader.style.opacity = '0';
                    preloader.style.visibility = 'hidden';
                    setTimeout(() => preloader.style.display = 'none', 700);
                };
                window.addEventListener('load', hidePreloader);
                setTimeout(hidePreloader, 4000);
            }

            // ===== REVEAL ANIMATION =====
            const revealEls = document.querySelectorAll('#bz-luxury-home .bz-reveal');
            if ('IntersectionObserver' in window) {
                const revealObserver = new IntersectionObserver((entries) => {
                    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
                }, { threshold: 0.12 });
                revealEls.forEach(el => revealObserver.observe(el));
            } else {
                revealEls.forEach(el => el.classList.add('visible'));
            }

            // ===== COURSES SLIDER (RTL + Mobile/Desktop Fix + Auto Scroll) =====
            const scrollWrapper = document.getElementById('coursesScroll');
            if (scrollWrapper) {
                const slides = scrollWrapper.querySelectorAll('.bz-course-item');
                const dots = document.querySelectorAll('#coursesDots .bz-dot');
                const prevBtn = document.getElementById('coursesPrev');
                const nextBtn = document.getElementById('coursesNext');
                let currentSlideIndex = 0;
                let autoScrollTimer;

                function scrollToIndex(index) {
                    if (index < 0) index = slides.length - 1; // برگشت به آخر اگر از اول رد شد
                    if (index >= slides.length) index = 0; // برگشت به اول اگر به آخر رسید
                    currentSlideIndex = index;
                    
                    const targetSlide = slides[currentSlideIndex];
                    if (targetSlide) {
                        const containerRect = scrollWrapper.getBoundingClientRect();
                        const slideRect = targetSlide.getBoundingClientRect();
                        const relativeLeft = slideRect.left - containerRect.left + scrollWrapper.scrollLeft;
                        const targetLeft = relativeLeft - (containerRect.width - slideRect.width) / 2;

                        scrollWrapper.scrollTo({
                            left: targetLeft,
                            behavior: 'smooth'
                        });
                    }
                    
                    updateActiveDot(currentSlideIndex);
                }

                function updateActiveDot(index) {
                    dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
                }

                // توابع اسکرول خودکار
                function startAutoScroll() {
                    stopAutoScroll();
                    autoScrollTimer = setInterval(() => {
                        scrollToIndex(currentSlideIndex + 1);
                    }, 5000); // هر ۵ ثانیه
                }

                function stopAutoScroll() {
                    if(autoScrollTimer) clearInterval(autoScrollTimer);
                }

                // شروع اسکرول خودکار در ابتدا
                startAutoScroll();

                // توقف اسکرول هنگام هاور یا لمس
                const sliderContainer = document.querySelector('.bz-courses-slider');
                sliderContainer.addEventListener('mouseenter', stopAutoScroll);
                sliderContainer.addEventListener('mouseleave', startAutoScroll);
                sliderContainer.addEventListener('touchstart', stopAutoScroll, {passive: true});
                sliderContainer.addEventListener('touchend', startAutoScroll);

                // دکمه‌های چپ و راست
                if (prevBtn) {
                    prevBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        scrollToIndex(currentSlideIndex - 1);
                    });
                }
                if (nextBtn) {
                    nextBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        scrollToIndex(currentSlideIndex + 1);
                    });
                }

                // دات‌های زیر اسلایدر
                dots.forEach(dot => {
                    dot.addEventListener('click', function() {
                        const idx = parseInt(this.dataset.index);
                        scrollToIndex(idx);
                    });
                });

                // همگام‌سازی دات با کشیدن دستی
                scrollWrapper.addEventListener('scroll', function() {
                    clearTimeout(scrollWrapper._scrollTimeout);
                    scrollWrapper._scrollTimeout = setTimeout(() => {
                        let minDiff = Infinity;
                        let activeIdx = 0;
                        const contRect = scrollWrapper.getBoundingClientRect();
                        const contCenter = contRect.left + contRect.width / 2;

                        slides.forEach((slide, idx) => {
                            const rect = slide.getBoundingClientRect();
                            const slideCenter = rect.left + rect.width / 2;
                            const diff = Math.abs(contCenter - slideCenter);
                            if (diff < minDiff) {
                                minDiff = diff;
                                activeIdx = idx;
                            }
                        });
                        currentSlideIndex = activeIdx;
                        updateActiveDot(activeIdx);
                    }, 100);
                }, { passive: true });
            }

            // ===== APPS BLUR OVERLAY =====
            const appGates = document.querySelectorAll('#bz-luxury-home .bz-app-gate');
            appGates.forEach(gate => {
                gate.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (this.classList.contains('loading')) return;

                    const href = this.dataset.href;
                    const type = this.dataset.type;

                    this.classList.add('loading');

                    setTimeout(() => {
                        if (type === 'web') {
                            window.location.href = href;
                        } else {
                            window.open(href, '_blank');
                        }
                        setTimeout(() => {
                            this.classList.remove('loading');
                        }, 800);
                    }, 2500);
                });
            });
        });
    </script>
    <?php
    return ob_get_clean();
}
